# Root frameworks are intentionally excluded; integrate separately in the future.
# CONFIG_KSU is not set
# CONFIG_KSU_SUSFS is not set
# CONFIG_SUSFS is not set
# CONFIG_KPM is not set
# CONFIG_APATCH is not set
# CONFIG_KERNELSU is not set

# Bounded diagnostic facilities; no continuous debug tracing.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
